PORT=2001
NODE_ENV=development
DB_DRIVER=sqlite
DATABASE_PATH=database/runtime/njust-math-stat.sqlite
# Production only: set DB_DRIVER=mysql and provide values through the cloud secret manager.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
# MySQL migration and seed never run at application startup. They require MYSQL_EXECUTE=1.
MYSQL_EXECUTE=0
# Internal experience-only identity login. Enable only for the test container, never as formal authentication.
ENABLE_TEST_IDENTITY_LOGIN=0
# Real WeChat Mini Program login. Set actual values only in cloud environment secrets.
WX_MINIPROGRAM_APP_ID=
WX_MINIPROGRAM_APP_SECRET=
# Invitation-only release bootstrap. Set a random 6-20 character value once in cloud secrets;
# the first authenticated user who enters it becomes the primary administrator.
INITIAL_ADMIN_INVITE_CODE=
