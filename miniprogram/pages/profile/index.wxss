.identity-block { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 2rpx 10rpx; }
.identity-mark, .avatar-image { flex: 0 0 104rpx; width: 104rpx; height: 104rpx; border-radius: 16rpx; }
.identity-mark { display: flex; align-items: center; justify-content: center; background: var(--indigo); color: #fff; box-shadow: 0 8rpx 18rpx rgba(64, 86, 200, 0.2); font-size: 22rpx; font-weight: 700; }
.identity-copy-wrap { flex: 1; min-width: 0; }
.identity-title-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-top: 5rpx; }
.identity-title { color: var(--ink); font-size: 35rpx; font-weight: 700; line-height: 1.3; }
.identity-copy { display: block; margin-top: 5rpx; color: var(--muted); font-size: 23rpx; line-height: 1.5; }
.profile-card { padding: 20rpx; }
.development-login { margin-top: 26rpx; padding: 22rpx; }
.development-login-title { display: block; color: var(--ink); font-size: 27rpx; font-weight: 700; }
.development-login text:not(.development-login-title) { display: block; margin-top: 6rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.development-login-button { width: 100%; margin-top: 20rpx; }
.editor-fields { display: flex; flex-direction: column; gap: 18rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid var(--line); }
.editor-note { color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.field-group { width: 100%; }
.save-profile { width: 100%; }
.binding-fields { display: flex; flex-direction: column; gap: 18rpx; }
.binding-title { color: var(--ink); font-size: 27rpx; font-weight: 700; }
.binding-copy { margin-top: -8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.binding-button { width: 100%; }
.readonly-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); color: var(--ink); font-size: 25rpx; }
.readonly-row text:last-child { max-width: 62%; color: var(--muted); text-align: right; word-break: break-all; }
.readonly-note { display: block; margin-top: 16rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.contact-placeholder { margin-top: 20rpx; padding: 18rpx 20rpx; border-left: 6rpx solid #a8b6e8; border-radius: 0 8rpx 8rpx 0; background: var(--indigo-soft); }
.contact-placeholder-title { display: block; color: var(--ink); font-size: 24rpx; font-weight: 700; }
.contact-placeholder-copy { display: block; margin-top: 6rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.admin-card { display: flex; flex-direction: column; gap: 18rpx; }
.admin-note, .admin-empty { color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.admin-search-row { display: flex; align-items: center; gap: 14rpx; }
.admin-search-input { flex: 1; min-width: 0; }
.admin-search-button { flex: 0 0 132rpx; min-width: 132rpx; margin: 0; padding: 0 12rpx; font-size: 24rpx; }
.admin-user-list { display: flex; flex-direction: column; gap: 10rpx; }
.admin-user-wrap { display: flex; align-items: stretch; gap: 12rpx; }
.admin-user-item { display: flex; flex: 1; align-items: center; justify-content: space-between; min-width: 0; min-height: 76rpx; padding: 14rpx 16rpx; border: 1rpx solid var(--line); border-radius: 8rpx; background: #fff; color: var(--ink); font-size: 24rpx; }
.admin-user-item text:last-child { color: var(--muted); font-size: 22rpx; }
.admin-user-item.selected { border-color: var(--indigo); background: var(--indigo-soft); }
.admin-user-status { display: block; margin-top: 4rpx; color: #39704b; font-size: 20rpx; }
.admin-user-status.banned { color: #b44b3b; }
.admin-ban-button { flex: 0 0 132rpx; min-width: 132rpx; margin: 0; padding: 0 10rpx; border: 1rpx solid #d99a92; border-radius: 8rpx; background: #fff5f3; color: #a33f32; font-size: 22rpx; }
.admin-ban-button::after { border: 0; }
.admin-ban-button.unban { border-color: #89b89a; background: #f0f8f1; color: #39704b; }
.admin-actions { display: flex; flex: 0 0 132rpx; flex-direction: column; justify-content: space-between; gap: 8rpx; }
.admin-actions .admin-ban-button { flex: 1; min-width: 132rpx; padding: 0 8rpx; font-size: 20rpx; }
.admin-role-button { flex: 1; min-width: 132rpx; margin: 0; padding: 0 8rpx; border: 1rpx solid #a8b6e8; border-radius: 8rpx; background: #f3f5ff; color: var(--indigo); font-size: 20rpx; }
.admin-role-button::after { border: 0; }
.admin-role-button.revoke { border-color: #d9b18e; background: #fff8ef; color: #91602f; }
.primary-transfer-button { flex: 1; min-width: 132rpx; margin: 0; padding: 0 6rpx; border: 1rpx solid #7ca2ad; border-radius: 8rpx; background: #eef7f8; color: #315f69; font-size: 19rpx; }
.primary-transfer-button::after { border: 0; }
.admin-editor { display: flex; flex-direction: column; gap: 16rpx; padding-top: 4rpx; border-top: 1rpx solid var(--line); }
