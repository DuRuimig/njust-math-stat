<view class="page-shell profile-page">
  <view class="identity-block">
    <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="identity-mark">南理数统</view>
    <view class="identity-copy-wrap">
      <text class="eyebrow">个人中心</text>
       <view class="identity-title-line"><text class="identity-title">{{isLoggedIn ? (nickname || (isTestIdentityMode ? '测试用户' : '微信用户')) : '未登录'}}</text><text class="status-chip">{{loginStatus}}</text></view>
       <text class="identity-copy">{{isTestIdentityMode ? '测试身份仅用于体验，不等同于学校统一身份认证或微信认证。' : '使用微信官方登录凭据完成服务端认证，不接受客户端提交身份标识。'}}</text>
    </view>
  </view>

   <view class="service-notice"><text>{{serviceStatus}}</text><text wx:if="{{isCloudMode}}">当前通过云托管服务完成认证和业务请求。</text><text wx:else>开发默认地址为 http://127.0.0.1:2001，不能用于真机访问。</text></view>

   <view wx:if="{{!isLoggedIn}}" class="development-login surface"><text class="development-login-title">微信登录</text><text>登录后可管理个人资料，并使用点赞和匿名评论。</text><button class="primary-button development-login-button" loading="{{isCreatingSession}}" disabled="{{isCreatingSession}}" bindtap="loginWithWechat">微信登录</button></view>

  <view class="section-head"><text class="section-title">身份资料</text><button wx:if="{{isLoggedIn}}" class="text-button" bindtap="toggleProfileEditor">{{isEditingProfile ? '收起' : '编辑昵称'}}</button></view>
  <view class="profile-card surface">
    <view wx:if="{{isEditingProfile}}" class="editor-fields">
      <text class="editor-note">当前版本仅支持修改昵称；头像暂不支持上传或保存。</text>
      <view class="field-group"><text class="field-label">昵称</text><input class="field-input" value="{{nickname}}" maxlength="24" placeholder="最多 24 个字符" bindinput="onNicknameInput" /></view>
      <button class="primary-button save-profile" loading="{{isSavingProfile}}" disabled="{{isSavingProfile}}" bindtap="saveProfile">保存资料</button>
    </view>
    <view wx:if="{{isLoggedIn && bindingStatus === 'unbound'}}" class="binding-fields">
      <text class="binding-title">首次绑定身份资料</text>
      <text class="binding-copy">请填写姓名和学号。绑定后不能在此页面修改。</text>
      <view class="field-group"><text class="field-label">姓名</text><input class="field-input" value="{{studentName}}" maxlength="80" placeholder="请输入姓名" bindinput="onStudentNameInput" /></view>
      <view class="field-group"><text class="field-label">学号</text><input class="field-input" value="{{studentId}}" maxlength="32" placeholder="请输入学号" bindinput="onStudentIdInput" /></view>
       <button class="primary-button binding-button" loading="{{isBindingProfile}}" disabled="{{isBindingProfile}}" bindtap="bindProfile">确认首次绑定</button>
    </view>
    <block wx:if="{{isLoggedIn && bindingStatus === 'bound'}}">
      <view class="readonly-row"><text>姓名</text><text>{{studentName}}</text></view>
      <view class="readonly-row"><text>学号</text><text>{{studentId}}</text></view>
       <text class="readonly-note">姓名与学号为私有只读资料，绝不会展示在匿名评论中。</text>
      <view class="contact-placeholder {{isAdminContactExpanded ? 'expanded' : ''}}" bindtap="toggleAdminContact">
        <view class="contact-placeholder-heading">
          <text class="contact-placeholder-title">身份资料如有误，请联系管理员更正</text>
          <text class="contact-toggle">{{isAdminContactExpanded ? '收起' : '展开'}}</text>
        </view>
        <view wx:if="{{isAdminContactExpanded}}" class="contact-details">
          <text class="contact-placeholder-copy">管理员更正后，该账号需要使用新的姓名和学号重新登录。</text>
          <button class="contact-admin-button" catchtap="openAdminQr">联系管理员</button>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{isLoggedIn && isAdmin}}" class="section-head"><text class="section-title">管理员</text></view>
  <view wx:if="{{isLoggedIn && isAdmin}}" class="profile-card surface admin-card">
    <text class="admin-note">搜索已登录用户后可更正身份、管理账号及评论；主管理员还可以设置普通管理员和移交主管理员。更正身份会使该用户的旧登录状态失效。</text>
    <view class="admin-search-row"><input class="field-input admin-search-input" value="{{adminQuery}}" maxlength="80" placeholder="姓名或学号" bindinput="onAdminQueryInput" confirm-type="search" bindconfirm="searchAdminUsers" /><button class="primary-button admin-search-button" loading="{{isSearchingAdminUsers}}" disabled="{{isSearchingAdminUsers}}" bindtap="searchAdminUsers">搜索</button></view>
    <view wx:if="{{adminUsers.length}}" class="admin-user-list"><view wx:for="{{adminUsers}}" wx:key="id" class="admin-user-wrap"><view class="admin-user-item {{adminEditingUserId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectAdminUser"><view><text>{{item.name || '未绑定姓名'}}</text><text class="admin-user-status {{item.isBanned ? 'banned' : ''}}">{{item.isBanned ? '已封禁' : (item.isPrimaryAdmin ? '主管理员' : (item.isAdmin ? '管理员' : '正常'))}}</text></view><text>{{item.studentNumber || '未绑定学号'}}</text></view><view class="admin-actions"><button wx:if="{{item.id !== currentUserId && (!item.isAdmin || isPrimaryAdmin)}}" class="admin-ban-button {{item.isBanned ? 'unban' : ''}}" data-id="{{item.id}}" data-banned="{{item.isBanned}}" loading="{{adminStatusChangingUserId === item.id}}" disabled="{{adminStatusChangingUserId || adminDeletingUserId || adminRoleChangingUserId || primaryTransferUserId}}" bindtap="toggleAdminUserStatus">{{item.isBanned ? '解除封禁' : '封禁账号'}}</button><button wx:if="{{item.id !== currentUserId && (!item.isAdmin || isPrimaryAdmin)}}" class="admin-delete-button" data-id="{{item.id}}" loading="{{adminDeletingUserId === item.id}}" disabled="{{adminStatusChangingUserId || adminDeletingUserId || adminRoleChangingUserId || primaryTransferUserId}}" bindtap="deleteAdminUser">永久删除</button><button wx:if="{{isPrimaryAdmin && item.id !== currentUserId && !item.isPrimaryAdmin && !item.isBanned}}" class="admin-role-button {{item.isAdmin ? 'revoke' : ''}}" data-id="{{item.id}}" data-admin="{{item.isAdmin}}" loading="{{adminRoleChangingUserId === item.id}}" disabled="{{adminStatusChangingUserId || adminDeletingUserId || adminRoleChangingUserId || primaryTransferUserId}}" bindtap="toggleAdminUserRole">{{item.isAdmin ? '撤销管理' : '设为管理员'}}</button><button wx:if="{{isPrimaryAdmin && item.id !== currentUserId && !item.isPrimaryAdmin && !item.isBanned}}" class="primary-transfer-button" data-id="{{item.id}}" loading="{{primaryTransferUserId === item.id}}" disabled="{{adminStatusChangingUserId || adminDeletingUserId || adminRoleChangingUserId || primaryTransferUserId}}" bindtap="transferPrimaryAdmin">移交主管理员</button></view></view></view>
    <text wx:if="{{!isSearchingAdminUsers && adminQuery && !adminUsers.length}}" class="admin-empty">没有找到匹配用户</text>
    <view wx:if="{{adminEditingUserId}}" class="admin-editor"><view class="field-group"><text class="field-label">姓名</text><input class="field-input" value="{{adminEditingName}}" maxlength="80" bindinput="onAdminNameInput" /></view><view class="field-group"><text class="field-label">12 位学号</text><input class="field-input" value="{{adminEditingStudentNumber}}" maxlength="12" bindinput="onAdminStudentNumberInput" /></view><button class="primary-button save-profile" loading="{{isSavingAdminIdentity}}" disabled="{{isSavingAdminIdentity}}" bindtap="saveAdminIdentity">保存更正</button></view>
  </view>

  <view wx:if="{{isAdminQrOpen}}" class="admin-qr-overlay" bindtap="closeAdminQr">
    <view class="admin-qr-dialog" catchtap="keepAdminQrOpen">
      <view class="admin-qr-head"><text class="admin-qr-title">联系管理员</text><button class="admin-qr-close" bindtap="closeAdminQr" aria-label="关闭">×</button></view>
      <text class="admin-qr-copy">扫码添加管理员，申请更正姓名或学号。</text>
      <image wx:if="{{!adminQrImageError}}" class="admin-qr-image" src="/assets/images/admin-wechat-qr.jpg" mode="aspectFit" binderror="onAdminQrImageError"></image>
      <view wx:else class="admin-qr-error"><text>二维码加载失败，请稍后重试</text></view>
    </view>
  </view>
</view>
