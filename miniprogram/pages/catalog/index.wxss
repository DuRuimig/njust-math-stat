.catalog-header {
  padding: 12rpx 4rpx 0;
}

.catalog-header .page-title {
  display: block;
  margin-top: 10rpx;
}

.announcement {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce2ff;
  border-left: 6rpx solid var(--indigo);
  border-radius: 8rpx;
  background: #f8f9ff;
  color: #55648e;
  font-size: 22rpx;
  line-height: 1.55;
}

.announcement-label {
  flex: 0 0 auto;
  color: var(--indigo-strong);
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 700;
}

.announcement-content {
  flex: 1;
  min-width: 0;
}

.announcement-title,
.announcement-copy {
  display: block;
  overflow-wrap: anywhere;
}

.announcement-title {
  color: var(--indigo-strong);
  font-size: 23rpx;
  font-weight: 700;
}

.announcement-copy {
  margin-top: 4rpx;
}

.filter-panel {
  margin-top: 22rpx;
  padding: 22rpx;
}

.filter-panel-head { margin-bottom: 22rpx; }
.filter-panel-head text:first-child { color: var(--ink); font-size: 27rpx; font-weight: 700; }

.picker-label {
  display: block;
  margin-bottom: 9rpx;
  color: var(--ink-secondary);
  font-size: 22rpx;
  font-weight: 700;
}

.picker-field + .picker-field {
  margin-top: 18rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 9rpx;
  background: #fafbfe;
  color: var(--ink);
  font-size: 24rpx;
}

.picker-value text {
  color: var(--indigo);
  font-size: 25rpx;
}

.filter-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.course-card {
  display: flex;
  align-items: stretch;
  width: 100%;
  overflow: hidden;
  transition: transform 120ms ease, background-color 120ms ease;
}

.course-card:active {
  background: #f8f9ff;
  transform: scale(0.992);
}

.course-main {
  flex: 1;
  min-width: 0;
  padding: 18rpx 16rpx;
}

.course-name-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.course-name {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.38;
  text-align: left;
}

.course-code {
  color: #70818B;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: right;
}

.course-major {
  display: block;
  margin: 8rpx 0 14rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-align: left;
}

.tag-stage {
  color: #4f6188;
  background: #f1f4fb;
}

.card-arrow {
  align-self: center;
  padding: 0 16rpx 0 2rpx;
  color: var(--indigo);
  font-size: 42rpx;
  font-weight: 300;
}
